digraph PolynomialIdeal {
  rankdir=LR;
  graph [fontname="Helvetica"];
  node [fontname="Helvetica"];
  ideal [shape=box, style="rounded", label="Ideal\nQ[x,y]/degrevlex\nreduced"];
  var_x [shape=ellipse, label="x"];
  var_y [shape=ellipse, label="y"];
  g1 [shape=box, label="g1: y^4-x"];
  ideal -> g1;
  lt1 [shape=diamond, label="LT: y^4"];
  g1 -> lt1;
  lt1 -> var_y [label="4"];
  g2 [shape=box, label="g2: x^2-y^2"];
  ideal -> g2;
  lt2 [shape=diamond, label="LT: x^2"];
  g2 -> lt2;
  lt2 -> var_x [label="2"];
  g3 [shape=box, label="g3: x*y-y^2"];
  ideal -> g3;
  lt3 [shape=diamond, label="LT: x*y"];
  g3 -> lt3;
  lt3 -> var_x [label="1"];
  lt3 -> var_y [label="1"];
}
